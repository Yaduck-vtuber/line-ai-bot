# LINE Bot 憑證 (從 LINE Developers Console 取得)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Gemini API Key (從 Google AI Studio 取得)
GEMINI_API_KEY=your_gemini_api_key_here

# 品牌名稱 (用於回覆身分與法案透明度標籤)
CLIENT_NAME=澄光行旅 Lumina Boutique Hotel

# 模型選擇 (預設使用官方最新高能輕量模型 gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 【零程式碼維護】動態知識庫 (留空則使用程式內建的澄光行旅 FAQ)
# CLIENT_KNOWLEDGE_BASE=---【基本資訊】---...

# 【零程式碼維護】外部即時知識庫 URL (支援 Notion / GitHub Gist / JSON Raw URL，若設定則自動 5 分鐘快取並即時同步)
# KNOWLEDGE_BASE_URL=https://raw.githubusercontent.com/.../hotel_faq.txt

# 伺服器連接埠
PORT=8080
